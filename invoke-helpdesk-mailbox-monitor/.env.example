# =============================================================================
# Invoke-HelpdeskMailboxMonitor – Konfiguration
# Kopiere diese Datei nach .env und fuelle die Werte aus.
# .env wird NICHT ins Repository committed (siehe .gitignore).
# =============================================================================

# Azure Infrastruktur
SUBSCRIPTION_ID="your-subscription-id"
RG="rg-your-resource-group"
AA="aa-your-automation-account"
LOCATION="westeurope"
MI_OBJECT_ID="your-managed-identity-object-id"

# Runbook
RUNBOOK_NAME="Invoke-HelpdeskMailboxMonitor"
RUNTIME_ENV="PowerShell-7-4"   # gemeinsame PS-7.4-Runtime des Automation Accounts (Name je Account pruefen)

# Schedule (stuendlich; Azure Automation erlaubt kein kuerzeres Intervall pro Schedule)
SCHEDULE_NAME="hourly-helpdesk-mailbox-monitor"

# Zustand (Automation-Variable, verhindert Alert-Spam waehrend einer Stoerung)
STATE_VARIABLE_NAME="HelpdeskBacklogAlertActive"

# Postfach / Alerting
MAILBOX_UPN="helpdesk@yourdomain.com"
SENDER_MAILBOX="automation@yourdomain.com"
ALERT_RECIPIENTS="it-team@yourdomain.com"   # kommagetrennt, auch Teams-Kanal-Adresse (…@de.teams.ms); NICHT das ueberwachte Postfach
THRESHOLD_MINUTES="5"
MIN_MESSAGE_COUNT="1"
